{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Instrument Detection - Data Exploration\n",
    "\n",
    "This notebook explores the audio dataset and extracted MFCC features."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.append(str(Path('..').resolve()))\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from src.config_loader import config\n",
    "from src.audio_processor import AudioProcessor\n",
    "from src.data_preparation import load_prepared_data\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "sns.set_palette('husl')\n",
    "\n",
    "print(\"Configuration loaded:\")\n",
    "print(f\"  Classes: {config.get('classes')}\")\n",
    "print(f\"  Samples per class: {config.get('classes.samples_per_class')}\")\n",
    "print(f\"  MFCC features: {config.get('data.n_mfcc')}\")\n",
    "print(f\"  Sample rate: {config.get('data.sample_rate')}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load prepared data\n",
    "X, y = load_prepared_data()\n",
    "\n",
    "classes = config.get('classes')\n",
    "print(f\"Features shape: {X.shape}\")\n",
    "print(f\"Labels shape: {y.shape}\")\n",
    "\n",
    "# Class distribution\n",
    "unique, counts = np.unique(y, return_counts=True)\n",
    "for cls_idx, count in zip(unique, counts):\n",
    "    print(f\"  {classes[cls_idx]}: {count} samples\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature statistics\n",
    "feature_cols = [f'MFCC_{i+1}' for i in range(X.shape[1])]\n",
    "df = pd.DataFrame(X, columns=feature_cols)\n",
    "df['label'] = [classes[i] for i in y]\n",
    "\n",
    "print(\"Feature Statistics:\")\n",
    "print(df.describe().T[['mean', 'std', 'min', 'max']].head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize MFCC features by class\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for i, cls in enumerate(classes):\n",
    "    class_data = df[df['label'] == cls].iloc[:, :-1]\n",
    "    mean_mfcc = class_data.mean()\n",
    "    std_mfcc = class_data.std()\n",
    "    \n",
    "    axes[i].plot(mean_mfcc.values, label='Mean', color='blue')\n",
    "    axes[i].fill_between(range(len(mean_mfcc)), \n",
    "                         mean_mfcc - std_mfcc, \n",
    "                         mean_mfcc + std_mfcc, \n",
    "                         alpha=0.3, color='blue', label='±1 Std')\n",
    "    axes[i].set_title(f'{cls.capitalize()}')\n",
    "    axes[i].set_xlabel('MFCC Coefficient')\n",
    "    axes[i].set_ylabel('Value')\n",
    "    axes[i].legend()\n    " \n",
    "# Remove empty subplot\n",
    "axes[-1].axis('off')\n",
    "\n",
    "plt.suptitle('Mean MFCC Features by Instrument Class', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation heatmap of MFCC features\n",
    "corr = df.iloc[:, :-1].corr()\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "mask = np.triu(np.ones_like(corr, dtype=bool))\n",
    "sns.heatmap(corr, mask=mask, cmap='RdBu_r', center=0,\n",
    "            square=True, linewidths=0.5, cbar_kws={'shrink': 0.8})\n",
    "plt.title('MFCC Feature Correlation Matrix')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pairplot of first few MFCCs\n",
    "plot_cols = ['MFCC_1', 'MFCC_2', 'MFCC_3', 'MFCC_4', 'MFCC_5', 'label']\n",
    "sns.pairplot(df[plot_cols], hue='label', diag_kind='kde', \n",
    "             plot_kws={'alpha': 0.6, 's': 30})\n",
    "plt.suptitle('MFCC Pairwise Relationships (First 5 Coefficients)', y=1.02)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Box plots for key MFCCs by class\n",
    "key_mfccs = ['MFCC_1', 'MFCC_2', 'MFCC_3', 'MFCC_4', 'MFCC_5', 'MFCC_10', 'MFCC_20', 'MFCC_30']\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(16, 8))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for i, mfcc in enumerate(key_mfccs):\n",
    "    sns.boxplot(data=df, x='label', y=mfcc, ax=axes[i])\n",
    "    axes[i].set_title(f'{mfcc} by Class')\n",
    "    axes[i].tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PCA visualization\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "pca = PCA(n_components=2)\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "plt.figure(figsize=(10, 7))\n",
    "for i, cls in enumerate(classes):\n",
    "    mask = y == i\n",
    "    plt.scatter(X_pca[mask, 0], X_pca[mask, 1], \n",
    "                label=cls, alpha=0.7, s=60)\n",
    "\n",
    "plt.xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%} variance)')\n",
    "plt.ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%} variance)')\n",
    "plt.title('PCA of MFCC Features')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "print(f\"Explained variance ratio: {pca.explained_variance_ratio_}\")\n",
    "print(f\"Cumulative: {np.cumsum(pca.explained_variance_ratio_)[:10]}\")"
   ]
  }
 ],
